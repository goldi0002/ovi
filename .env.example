# Copy to .env and fill in. Never commit .env.

# The address people use to reach Ovi. Short links and QR codes are built from it.
OVI_PUBLIC_URL=https://links.example.com

# The admin key: full access to every link. At least 32 characters. Generate one with: openssl rand -hex 32
OVI_API_KEY=

# Password for the bundled Postgres. Letters and digits only. Generate one with: openssl rand -hex 24
POSTGRES_PASSWORD=

# Port on this machine. Default 8080.
# OVI_PORT=8080

# Optional sign-in with Google or GitHub, admins, and the Safe Browsing check.
# Uncomment the matching lines in docker-compose.yml too. See "Configuration" in the README.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# ADMIN_EMAILS=you@example.com
# SAFE_BROWSING_API_KEY=
